# Application
NODE_ENV=development
PORT=8080

# MongoDB — local: mongodb://localhost:27017/ticketing | Atlas: mongodb+srv://...
MONGO_URI=mongodb://localhost:27017/ticketing

# Redis — local: redis://localhost:6379 | Upstash: rediss://...
REDIS_URL=redis://localhost:6379

# Seat hold duration in seconds (default: 600 = 10 minutes)
SEAT_HOLD_TTL_SECONDS=600
